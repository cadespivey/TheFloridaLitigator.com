    "procedure_url": "https://jud14.flcourts.org/uploaded/media/Revised%20Bay%20County%20Scheduling%20Procedures%20Civil%20Division.10.2023.pdf",
    "procedure_revision": "October 2023",
    "checklist": [
      {
        "category": "scheduling",
        "summary": "File and serve the motion before requesting a hearing by email to the assistant, copying all parties and supplying case number, motion, counsel names and time requested. Clear the date with all parties, confirm within three business days, and await written office confirmation before filing and serving the notice within five business days. Use Central Time. Email cancellations even if a notice was filed; only the scheduling party may cancel the motion hearing.",
        "source_url": "https://jud14.flcourts.org/uploaded/media/Revised%20Bay%20County%20Scheduling%20Procedures%20Civil%20Division.10.2023.pdf"
      },
      {
        "category": "conferral",
        "summary": "Certify opposing counsel/party received the motion and that good-faith conferral occurred. Keep the assistant out of interparty date-coordination emails; email the assistant for dates and final confirmation.",
        "source_url": "https://jud14.flcourts.org/uploaded/media/Revised%20Bay%20County%20Scheduling%20Procedures%20Civil%20Division.10.2023.pdf"
      },
      {
        "category": "submissions",
        "summary": "Request a OneDrive link from the assistant, copying all parties. Submit hearing materials at least three business days before the hearing. Hard copies are a fallback only if using the drop box is impossible and must arrive by that deadline. Do not email copies of hearing documents.",
        "source_url": "https://jud14.flcourts.org/uploaded/media/Revised%20Bay%20County%20Scheduling%20Procedures%20Civil%20Division.10.2023.pdf"
      },
      {
        "category": "proposed_orders",
        "summary": "Ordinarily use the circuit e-filing portal with a PDF cover letter stating agreement or at least seven days without a response. Contested orders are excluded from that route: contact the office to schedule a hearing; try to resolve disagreements, and if unresolved email each proposed order and a copy highlighting disputed portions to the assistant. Preserve the source requirement for service on parties not registered for portal service.",
        "source_url": "https://jud14.flcourts.org/uploaded/media/Revised%20Bay%20County%20Scheduling%20Procedures%20Civil%20Division.10.2023.pdf"
      },
      {
        "category": "courtesy_copies",
        "summary": "The guide addresses hearing materials rather than labeling a separate courtesy-copy procedure. Documents already accessible in the court file ordinarily need not be resubmitted; follow the stated exception for incorporated or hard-to-identify materials.",
        "source_url": "https://jud14.flcourts.org/uploaded/media/Revised%20Bay%20County%20Scheduling%20Procedures%20Civil%20Division.10.2023.pdf"
      },
      {
        "category": "remote_appearance",
        "summary": "The October 2023 guide states telephone/Zoom for non-evidentiary hearings, Zoom for evidentiary hearings of one hour or less, and in-person appearances for longer evidentiary hearings. Requests for non-evidentiary in-person hearings must be written with specific reasons. Preserve the differing Zoom audience wording separately.",
        "source_url": "https://jud14.flcourts.org/uploaded/media/Revised%20Bay%20County%20Scheduling%20Procedures%20Civil%20Division.10.2023.pdf"
      },
      {
        "category": "communications",
        "summary": "Copy all parties/counsel on court emails and include the case number in the subject. Mira Phillips is expressly reachable at 850-747-5320 for procedural questions; hearing time is requested by email, not phone.",
        "source_url": "https://jud14.flcourts.org/uploaded/media/Revised%20Bay%20County%20Scheduling%20Procedures%20Civil%20Division.10.2023.pdf"
      }
    ],
    "conflicts": [
      "Page 5 limits Zoom information to attorneys and defendants and mentions felony livestreams; section 4B addresses attorneys/parties and section 5 addresses witnesses. Preserve these statements without resolving their scope."
    ],
