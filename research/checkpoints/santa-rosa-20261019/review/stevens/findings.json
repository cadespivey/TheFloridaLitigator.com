      "checklist": [
        {
          "topic": "communications",
          "summary": "Email the assistant, identify the case and matter, and copy all parties. The published phone is an office contact; the communications section directs email.",
          "citation": {
            "url": "https://www.firstjudicialcircuit.org/legal-professionals/judges/david-stevens/",
            "http_status": 200,
            "retrieved_at": "2026-10-19T23:53:09.713Z",
