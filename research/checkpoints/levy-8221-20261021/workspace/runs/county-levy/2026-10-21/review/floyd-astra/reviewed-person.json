    "checklist": [
      {
        "category": "communications",
        "summary": "Email the foreclosure case manager with case number, name and matter, copying all parties unless authorized otherwise. Attach relevant pleadings when requesting a hearing or entry of an order.",
        "source_url": "https://circuit8.org/general-magistrates-hearing-officers/circuit-wide-civil-division-mg-foreclosures/"
      },
      {
        "category": "scheduling",
        "summary": "Email county, case number/style, motion, attorneys and requested time. File/serve the notice after reserving time (except court case-management conferences); obtain approval before cancelling.",
        "source_url": "https://circuit8.org/general-magistrates-hearing-officers/circuit-wide-civil-division-mg-foreclosures/"
      },
      {
        "category": "remote_appearances",
        "summary": "Routine case-management conferences and qualifying short or uncontested non-evidentiary matters typically use Zoom; use notice credentials. An in-person setting requires approval for remote appearance; follow the guide\u2019s request procedure.",
        "source_url": "https://circuit8.org/general-magistrates-hearing-officers/circuit-wide-civil-division-mg-foreclosures/"
      },
      {
        "category": "proposed_orders",
        "summary": "Send Word orders by email to the foreclosure inbox or through the portal, after applicable notice periods. File motions/supporting documents with the clerk; do not send originals to the magistrate unless requested.",
        "source_url": "https://circuit8.org/general-magistrates-hearing-officers/circuit-wide-civil-division-mg-foreclosures/"
      },
      {
        "category": "courtesy_copies",
        "summary": "Email electronic PDF/Word courtesy copies. Scheduling gives five business days for hearing materials; the courtesy-copy section gives two days before evidentiary proceedings. Preserve both instructions and consult the guide.",
        "source_url": "https://circuit8.org/general-magistrates-hearing-officers/circuit-wide-civil-division-mg-foreclosures/"
      }
    ],
