<script>
    $(document).ready(function () {
        // Cache the container
        var $grid = $('.sort-destination');

        // Initialize Isotope once images are loaded (prevents layout bugs)
        $grid.imagesLoaded(function () {
            $grid.isotope({
                itemSelector: '.isotope-item',
                layoutMode: 'fitRows',   // or 'masonry' if you prefer uneven heights
                transitionDuration: '0.6s'
            });
        });

        // Filter clicks – delegate from the parent to handle dynamic content
        $('.sort-source').on('click', 'li', function (e) {
            e.preventDefault();

            var $this = $(this);
            var optionValue = $this.data('option-value');
            var filterValue;

            if (optionValue === '*') {
                // Reset all actives
                $('.sort-source li').removeClass('active');
                $this.addClass('active');
                filterValue = '*';
            } else {
                // Deactivate Show All
                $('.sort-source li[data-option-value="*"]').removeClass('active');

                // Find the parent group
                var $group = $this.closest('ul.btn-group');

                if ($this.hasClass('active')) {
                    $this.removeClass('active');
                } else {
                    // Remove active from other li in same group
                    $group.find('li').removeClass('active');
                    // Add to this
                    $this.addClass('active');
                }

                // Collect all active filters that are not empty
                var filters = [];
                $('.sort-source li.active').each(function () {
                    var val = $(this).data('option-value');
                    if (val !== '') {
                        filters.push(val);
                    }
                });

                filterValue = filters.length > 0 ? filters.join('') : '*';

                if (filterValue === '*') {
                    $('.sort-source li[data-option-value="*"]').addClass('active');
                }
            }

            // Apply filter
            $grid.isotope({ filter: filterValue });
            // Check for no results after arrange complete
            $grid.one('arrangeComplete', function (event, filteredItems) {
                if (filteredItems.length === 0) {
                    $('#no-results').show();
                } else {
                    $('#no-results').hide();
                }
            });
        });

        // Optional: trigger "Show All" on page load
        $('.sort-source li[data-option-value="*"]').click();
    });
</script>
