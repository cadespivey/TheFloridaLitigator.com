//cdn.sanity.io/images/xf5z3ibd/production/8322b353501be29c790a0f46fc9cc6ca30bb7aa6-200x150.jpg?rect=50,0,100,150&w=%width%&h=%height%&q=80","id":"image-8322b353501be29c790a0f46fc9cc6ca30bb7aa6-200x150-jpg","children":[],"parent":null}},"slug":{"current":"m-c-blanchard-judicial-building"},"title":"M.C. Blanchard Judicial Building"}]},"judge":{"county_upper":"walton county","divisions":"C","fax":"N/A","judge_type":"circuit","metaDescription":null,"metaTitle":null,"phone":"(850) 892-8472","judicialAssistant":"Tracie Fields, tracie.fields@flcourts1.gov","address":"Walton County Courthouse, 571 U.S. Highway 90 East DeFuniak Springs, FL  32433","onceHubParam":"judgeschlechter","_rawPreferences":[{"_key":"d84ae912951d","_type":"richText","blockText":[{"_key":"ba97432d4adb","_type":"block","children":[{"_key":"cf6eab5985980","_type":"span","marks":["strong"],"text":"A. Communications with the Judicial Office"}],"markDefs":[],"style":"normal"},{"_key":"4e945372c271","_type":"block","children":[{"_key":"eb93a8affb1b0","_type":"span","marks":["strong"],"text":"Method of Communication:"},{"_key":"eb93a8affb1b1","_type":"span","marks":[],"text":" All communications to the judicial office must be submitted by e-mail to "},{"_key":"34b41442a30d","_type":"span","marks":["34a9dbd47ce0"],"text":"Tracie.fields@flcourts1.gov"},{"_key":"b00c3f8ec12f","_type":"span","marks":[],"text":". The subject line of any e-mail to the judicial office must contain the case number, case name, and relevant matter "},{"_key":"eb93a8affb1b4","_type":"span","marks":["strong"],"text":"(e.g., 2024 DR 001234 SC – Doe v. Doe – 2-Hour Hearing Requested)."}],"level":1,"listItem":"bullet","markDefs":[{"_key":"34a9dbd47ce0","_type":"link","href":"Tracie.fields@flcourts1.gov"}],"style":"normal"},{"_key":"4cdbc2cd7e88","_type":"block","children":[{"_key":"238a28f7a6bf0","_type":"span","marks":["strong"],"text":"Ex parte Communications:"},{"_key":"238a28f7a6bf1","_type":"span","marks":[],"text":" All communications with the judicial office must comply with Canon 3 of the Code of Judicial Conduct, which prohibits a judge from initiating, permitting, or considering ex parte communications and from considering other communications outside the presence of the parties concerning a pending or impending proceeding, unless authorized by law. All parties must be copied on any e-mail directed to the judicial office, unless an "},{"_key":"238a28f7a6bf2","_type":"span","marks":["em"],"text":"ex parte"},{"_key":"238a28f7a6bf3","_type":"span","marks":[],"text":" communication is authorized by law."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"7117262bad45","_type":"block","children":[{"_key":"0476b654d76f0","_type":"span","marks":["strong"],"text":"The Judge’s Assistant is unable to provide legal advice, interpret court rules, explain how to file documents, or advise parties on legal rights or on what actions to take in your case."},{"_key":"0476b654d76f1","_type":"span","marks":[],"text":" Questions regarding legal matters should be directed to a licensed attorney or other appropriate legal resources."}],"level":1,"listItem":"bullet","markDefs":[{"_key":"2bea14e1f18f","_type":"link","href":"https://www.myflcourtaccess.com/authority/"}],"style":"normal"},{"_key":"3000bc74024f","_type":"block","children":[{"_key":"2d7a1af790f4","_type":"span","marks":[],"text":"The Florida Courts electronic portal can be found at the following link: "},{"_key":"d34ba4eee2fc1","_type":"span","marks":["2bea14e1f18f"],"text":"Florida Courts E-Filing Portal | File Court Documents Online"}],"level":1,"listItem":"bullet","markDefs":[{"_key":"2bea14e1f18f","_type":"link","href":"https://www.myflcourtaccess.com/authority/"}],"style":"normal"},{"_key":"8c8b4519bf36","_type":"block","children":[{"_key":"d5daf20ffb59","_type":"span","marks":[],"text":"The above website contains a frequently asked questions section and a how to section."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"8d806622afd4","_type":"block","children":[{"_key":"4023202992720","_type":"span","marks":["strong"],"text":"Unsolicited Communications:"},{"_key":"4023202992721","_type":"span","marks":[],"text":" Parties may only contact the judicial office in accordance with these practices and procedures. Unsolicited communications from non-parties will not be considered by the court."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"debad6f89fc7","_type":"block","children":[{"_key":"4e032b69b6e40","_type":"span","marks":["strong"],"text":"E-Filing Portal Contact Information: "},{"_key":"4e032b69b6e41","_type":"span","marks":[],"text":"All attorneys and self-represented litigants must make and receive service by e-mail, which is generally through the Florida Courts E-Filing Portal, unless excused. Fla. R. Gen. Prac. & Jud. Admin. 2.516."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"07de4ab23dae","_type":"block","children":[{"_key":"c48be1ffb59d0","_type":"span","marks":["strong"],"text":"B. Scheduling Procedures"}],"markDefs":[],"style":"normal"},{"_key":"73a6242e25fc","_type":"block","children":[{"_key":"48dff3cf45d40","_type":"span","marks":["strong"],"text":"Any motion(s) must be filed and docketed before submitting a request for hearing time."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"cdd7bde23759","_type":"block","children":[{"_key":"559b1f6985760","_type":"span","marks":["strong"],"text":"Final hearings/Trials must be scheduled by email to the JA at "},{"_key":"559b1f6985761","_type":"span","marks":["b05e631964ab","strong"],"text":"Tracie.Fields@flcourts1.gov"},{"_key":"efc3c18ffefb","_type":"span","marks":["strong"],"text":"."}],"level":1,"listItem":"bullet","markDefs":[{"_key":"b05e631964ab","_type":"link","href":"Tracie.Fields@flcourts1.gov"}],"style":"normal"},{"_key":"c7795df72644","_type":"block","children":[{"_key":"c1de2c482de80","_type":"span","marks":["strong"],"text":"Temporary Relief Hearings will generally be scheduled for 1 hour. Temporary relief hearings should be scheduled via OnceHub. If no hearing time is available on OnceHub within 45 days please contact Judge Schlechter’s JA to schedule the Temporary Relief Hearing. Judge Schlechter makes every effort to schedule Temporary Relief Hearings within 45 days of the hearing request."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"d420dc980ca4","_type":"block","children":[{"_key":"5e51e8488bce0","_type":"span","marks":["strong"],"text":"All other hearings 90 minutes or less must be scheduled via "},{"_key":"5e51e8488bce1","_type":"span","marks":["197f4f8b3a5f","strong"],"text":"OnceHub"},{"_key":"5e51e8488bce2","_type":"span","marks":["strong"],"text":"."}],"level":1,"listItem":"bullet","markDefs":[{"_key":"197f4f8b3a5f","_type":"link","href":"https://go.oncehub.com/judgeschlechter"}],"style":"normal"},{"_key":"a173da15a7f8","_type":"block","children":[{"_key":"cb8644b31c2e0","_type":"span","marks":["strong"],"text":"Hearings for more than 90 minutes must be scheduled directly with Judge Schlechter’s office by emailing his JA at "},{"_key":"cb8644b31c2e1","_type":"span","marks":["a14ede4bcc26","strong"],"text":"tracie.fields@flcourts1.gov"}],"level":1,"listItem":"bullet","markDefs":[{"_key":"a14ede4bcc26","_type":"link","href":"tracie.fields@flcourts1.gov"}],"style":"normal"},{"_key":"6ef6b2d9e853","_type":"block","children":[{"_key":"2717e1d152590","_type":"span","marks":["strong"],"text":"Notice of Hearing:"},{"_key":"2717e1d152591","_type":"span","marks":[],"text":" Notice of Hearing must be filed and served immediately after reserving hearing time."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"af6c39874e69","_type":"block","children":[{"_key":"2019a3a70f1d0","_type":"span","marks":[],"text":"If the hearing is scheduled to occur via Zoom, the notice must contain the Court’s Zoom ID."}],"markDefs":[],"style":"normal"},{"_key":"74534979de0f","_type":"block","children":[{"_key":"e03549fe411e0","_type":"span","marks":[],"text":"All notices of hearing must contain the Americans with Disabilities Act (ADA) notification required by Florida Rule of General Practice and Judicial Administration 2.540."}],"markDefs":[],"style":"normal"},{"_key":"cbe4e5230285","_type":"block","children":[{"_key":"a6bc22d2ab2e0","_type":"span","marks":["strong"],"text":"Submission Deadlines:"},{"_key":"a6bc22d2ab2e1","_type":"span","marks":[],"text":" The Court requires parties to comply with the Courtesy copy procedures outlined below."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"e6322342c64a","_type":"block","children":[{"_key":"ee2c01bda4de0","_type":"span","marks":["strong"],"text":"Continuance Procedure:"},{"_key":"ee2c01bda4de1","_type":"span","marks":[],"text":" Requests to continue must be in writing and filed with the Clerk."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"44249c1506c7","_type":"block","children":[{"_key":"b69283cf93b70","_type":"span","marks":["strong"],"text":"Cancelling Hearings:"},{"_key":"b69283cf93b71","_type":"span","marks":[],"text":" To cancel a hearing, the Court’s judicial assistant must be immediately notified via e-mail "},{"_key":"b69283cf93b72","_type":"span","marks":["strong"],"text":"and"},{"_key":"b69283cf93b73","_type":"span","marks":[],"text":" a notice of cancellation must be filed."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"68cdc7b74620","_type":"block","children":[{"_key":"a7a1ed3933400","_type":"span","marks":["strong"],"text":"Cancelling Final Hearings:"},{"_key":"a7a1ed3933401","_type":"span","marks":[],"text":" Final Hearings may only be cancelled by court order. Any such request must be in writing and filed with the clerk and a courtesy copy emailed to the Court’s Judicial Assistant."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"963d4fe09203","_type":"block","children":[{"_key":"7df2b7970d5c0","_type":"span","marks":["strong"],"text":"C. Remote Appearance"}],"markDefs":[],"style":"normal"},{"_key":"11a982f45277","_type":"block","children":[{"_key":"e552264ced810","_type":"span","marks":["strong"],"text":"Remote Appearance Procedure:"},{"_key":"e552264ced811","_type":"span","marks":[],"text":" Generally, any hearing scheduled for 1 hour or less may be conducted via Zoom if all parties agree. If all parties do not agree, an in-person hearing will be required and a motion and proposed order to appear by Zoom will be required."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"9bdacb87daf8","_type":"block","children":[{"_key":"c0034ec1126f0","_type":"span","marks":[],"text":"All Final Hearings/Trials will be in person. If a party seeks to have anyone appear via Zoom a motion and proposed order to appear by Zoom will be required. "}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"77e6c18f2735","_type":"block","children":[{"_key":"91ac7a93b33e0","_type":"span","marks":["strong"],"text":"Platform Used:"},{"_key":"91ac7a93b33e1","_type":"span","marks":[],"text":" Zoom (Zoom link will be provided after the hearing date is confirmed.)"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"6fb7d4574f55","_type":"block","children":[{"_key":"a29e873bc0400","_type":"span","marks":["strong"],"text":"Requirements:"},{"_key":"a29e873bc0401","_type":"span","marks":[],"text":" Participants must be able to use the audio and video functions of zoom. If the hearing is an evidentiary hearing, failure to have working video may result in the exclusion of testimony."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"70b87d765c35","_type":"block","children":[{"_key":"636ae11e4b450","_type":"span","marks":["strong"],"text":"D. Submission of Orders and Judgments"}],"markDefs":[],"style":"normal"},{"_key":"118931c910a2","_type":"block","children":[{"_key":"e1c032bbb6a90","_type":"span","marks":["strong"],"text":"Format:"},{"_key":"e1c032bbb6a91","_type":"span","marks":[],"text":" Word."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"dd00d181edf9","_type":"block","children":[{"_key":"5218f907d2620","_type":"span","marks":["strong"],"text":"Submission Method: "},{"_key":"5218f907d2621","_type":"span","marks":[],"text":"E-portal "},{"_key":"5218f907d2622","_type":"span","marks":["em"],"text":"unless directed otherwise by the Court."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"76a89e05157f","_type":"block","children":[{"_key":"bd2bfa883bac0","_type":"span","marks":["strong"],"text":"Deadline for Submissions:"},{"_key":"bd2bfa883bac1","_type":"span","marks":[],"text":" 10 days unless directed otherwise by the Court."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"71a1e8c3b360","_type":"block","children":[{"_key":"d742415092ba0","_type":"span","marks":["strong"],"text":"Other Procedures Relating to Submission of Orders and Judgments: "},{"_key":"d742415092ba1","_type":"span","marks":[],"text":"Proposed orders on contested motions should only be submitted if directed to do so by the Court."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"d324d8e04368","_type":"block","children":[{"_key":"3fa34358cc620","_type":"span","marks":["strong"],"text":"E. Courtesy Copies of Case Law and Other Documents"}],"markDefs":[],"style":"normal"},{"_key":"da1e5d919bca","_type":"block","children":[{"_key":"1d19df6904030","_type":"span","marks":["strong"],"text":"When Required:"},{"_key":"1d19df6904031","_type":"span","marks":[],"text":" All contested hearings (all case types)."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"c7cc13eb21e7","_type":"block","children":[{"_key":"387739e0816b0","_type":"span","marks":["strong"],"text":"Format:"},{"_key":"387739e0816b1","_type":"span","marks":[],"text":" PDF. "},{"_key":"387739e0816b2","_type":"span","marks":["strong"],"text":"Do not"},{"_key":"387739e0816b3","_type":"span","marks":[],"text":" submit hard copies/binders."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"2377f6503f3e","_type":"block","children":[{"_key":"bea3d4cf8f8f0","_type":"span","marks":["strong"],"text":"Submission Method: "},{"_key":"bea3d4cf8f8f1","_type":"span","marks":[],"text":"E-mail to the Court’s judicial assistant."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"67b6953b5633","_type":"block","children":[{"_key":"c87e505924880","_type":"span","marks":["strong"],"text":"Deadline for Submissions:"},{"_key":"c87e505924881","_type":"span","marks":[],"text":" 7 days prior to the hearing."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"60b3bc412177","_type":"block","children":[{"_key":"d61e9a0a28b10","_type":"span","marks":["strong"],"text":"Procedures: "},{"_key":"d61e9a0a28b11","_type":"span","marks":[],"text":"All documents should be combined into one (1) PDF. The PDF should be named in the following format: Case Number Party’s name Motion Name DIN of Motion, i.e. "},{"_key":"d61e9a0a28b12","_type":"span","marks":["strong"],"text":"2025CA000001 Smith Motion for Summary Judgment DIN 35"},{"_key":"d61e9a0a28b13","_type":"span","marks":[],"text":".The PDF must be searchable, contain a table of contents, and bookmarks for each item. The documents in the PDF should be in the following order:"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"b2fc3b847d22","_type":"block","children":[{"_key":"c308c775992c0","_type":"span","marks":[],"text":"Table of Contents"}],"level":2,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"e9215be8c9ce","_type":"block","children":[{"_key":"d07c44fef6ba0","_type":"span","marks":[],"text":"Notice of Hearing"}],"level":2,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"1abead38cc62","_type":"block","children":[{"_key":"b62cde5f5b3f0","_type":"span","marks":[],"text":"Motion/Opposition/etc."}],"level":2,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"fdb703dc61aa","_type":"block","children":[{"_key":"6140416658a70","_type":"span","marks":[],"text":"Opposing Party’s Motion/Opposition (if the party desires)"}],"level":2,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"c31545417de1","_type":"block","children":[{"_key":"9f54d2ca4ba70","_type":"span","marks":[],"text":"Reply (if applicable)"}],"level":2,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"10034a110077","_type":"block","children":[{"_key":"82989fcf9fa30","_type":"span","marks":[],"text":"Supporting documents"}],"level":2,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"bb4e4fee0cc5","_type":"block","children":[{"_key":"cfc1d9da6f530","_type":"span","marks":[],"text":"Case law"}],"level":2,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"f346c85860e8","_type":"block","children":[{"_key":"d4bc33cea84a0","_type":"span","marks":[],"text":"Other items"}],"level":2,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"2311b34b36a8","_type":"block","children":[{"_key":"69be3b0b14cf0","_type":"span","marks":[],"text":"Instructions to add bookmarks to a PDF can be found on the Adobe website as well as many other websites."}],"markDefs":[],"style":"normal"},{"_key":"fe8d5d49ba6d","_type":"block","children":[{"_key":"8459e991ca910","_type":"span","marks":[],"text":"Each party should only submit 1 PDF."}],"markDefs":[],"style":"normal"},{"_key":"16045ea3ca69","_type":"block","children":[{"_key":"bdaa9d5526f10","_type":"span","marks":["strong"],"text":"F. Emergency and Other Urgent Matters"}],"markDefs":[],"style":"normal"},{"_key":"c867319e2e04","_type":"block","children":[{"_key":"453becc292010","_type":"span","marks":["strong"],"text":"Requirements: "},{"_key":"453becc292011","_type":"span","marks":[],"text":"As required by law."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"9579d07fba26","_type":"block","children":[{"_key":"4d54e78b72880","_type":"span","marks":["strong"],"text":"Scheduling:"},{"_key":"4d54e78b72881","_type":"span","marks":[],"text":" If the Court determines that an emergency exists, a hearing will be scheduled unilaterally by the Court. The parties must make themselves available for the hearing."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"9794b70e1dbd","_type":"block","children":[{"_key":"da6b048d7d900","_type":"span","marks":["strong"],"text":"G. Exhibits for Evidentiary Proceedings"}],"markDefs":[],"style":"normal"},{"_key":"ea342ed56048","_type":"block","children":[{"_key":"64a13826e30a0","_type":"span","marks":["strong"],"text":"Submission Method: "},{"_key":"64a13826e30a1","_type":"span","marks":["em"],"text":"For remote proceedings"},{"_key":"64a13826e30a2","_type":"span","marks":[],"text":", all evidence must be filed electronically with the Clerk of Court at least 3 business days prior to the hearing."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"ba91f63b901d","_type":"block","children":[{"_key":"c44cce7d8ecb0","_type":"span","marks":["em"],"text":"For in person proceedings"},{"_key":"c44cce7d8ecb1","_type":"span","marks":[],"text":", the Court prefers that exhibits be electronically filed at least 3 business days prior to the hearings. If the exhibits have been filed with the Clerk 3 days prior to the hearing, paper or electronic exhibits may be used to question witnesses. If exhibits have not been filed with the Clerk at least 3 business days prior to the hearing, paper exhibits must be used. Exhibits should be marked prior to the hearing."}],"markDefs":[],"style":"normal"},{"_key":"26d9d7f1593d","_type":"block","children":[{"_key":"19e1428cc3db0","_type":"span","marks":["strong"],"text":"H. Pretrial Procedures and Conferences"}],"markDefs":[],"style":"normal"},{"_key":"1ebf45c77406","_type":"block","children":[{"_key":"724cb7358a320","_type":"span","marks":["strong"],"text":"Case Management Conference:"},{"_key":"724cb7358a321","_type":"span","marks":[],"text":" May be requested by any party or scheduled unilaterally by the Court."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"6e2f6776d055","_type":"block","children":[{"_key":"82d1b99386850","_type":"span","marks":["strong"],"text":"[Other Procedures Relating to Pretrial Procedures and Conferences]:"},{"_key":"82d1b99386851","_type":"span","marks":[],"text":" A trial order will be entered that establishes all relevant deadlines."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"ea03b3d58b09","_type":"block","children":[{"_key":"dcfc419be9330","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"032b1b6ad8fe","_type":"block","children":[{"_key":"a1128406759f0","_type":"span","marks":["strong"],"text":"I. Setting Case for Trial"}],"markDefs":[],"style":"normal"},{"_key":"fa71db88f435","_type":"block","children":[{"_key":"3558daa9b35d0","_type":"span","marks":["strong"],"text":"Procedure:"},{"_key":"3558daa9b35d1","_type":"span","marks":[],"text":" For family law cases, request a final hearing via email with Judge Schlechter’s JA. The hearing will be scheduled and an Order Setting Trial/Final Hearing will be prepared by the Court. A Case Management Conference may be required for any final hearing requesting more than 1 day."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"74d044162d7a","_type":"block","children":[{"_key":"23a3c98e153f0","_type":"span","marks":["strong"],"text":"J. Forms"}],"markDefs":[],"style":"normal"},{"_key":"111a4e3405dd","_type":"block","children":[{"_key":"be919d6b06be0","_type":"span","marks":["strong"],"text":"The Florida State Court System maintains a self-help center. The self-help center provides general information for self-represented litigants and access to numerous family law specific forms. The self-help center can be accessed by clicking on the following link:"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"f45e6df04075","_type":"block","children":[{"_key":"97fa02a8d2500","_type":"span","marks":["0f4b3df031de"],"text":"Family Law Forms / Domestic Relations Court Resources / Family Courts / Services - - Florida Courts"}],"markDefs":[{"_key":"0f4b3df031de","_type":"link","href":"https://www.flcourts.gov/Services/Family-Courts/domestic-relations-court-resources/family-law-forms"}],"style":"normal"},{"_key":"274bceefba70","_type":"block","children":[{"_key":"dd958f31b7460","_type":"span","marks":["strong"],"text":"Usage:"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"620def1586f1","_type":"block","children":[{"_key":"604a375644e60","_type":"span","marks":["strong"],"text":"[Other Forms Procedures]:"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"17bc7901c8fa","_type":"block","children":[{"_key":"b56747ac0f5c0","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"d5044c6bc499","_type":"block","children":[{"_key":"75eb760dfc550","_type":"span","marks":["strong"],"text":"K. Other Division Procedures"}],"markDefs":[],"style":"normal"},{"_key":"aeaeb82f962b","_type":"block","children":[{"_key":"5a528cc8d5a80","_type":"span","marks":["strong"],"text":"ADA Accommodations:"},{"_key":"5a528cc8d5a81","_type":"span","marks":[],"text":" Please contact Court administration at Phone (850) 595-4400 Fax (850) 595-0360, "},{"_key":"5a528cc8d5a82","_type":"span","marks":["a6cf0fdd73e4"],"text":"ADA.Walton@flcourts1.gov"},{"_key":"5a528cc8d5a83","_type":"span","marks":[],"text":" at least 7 days before your scheduled court appearance, or immediately upon receiving this notification if the time before the scheduled appearance is less than 7 days; if you are hearing or voice impaired, call 711."}],"level":1,"listItem":"bullet","markDefs":[{"_key":"a6cf0fdd73e4","_type":"link","href":"ADA.Walton@flcourts1.gov"}],"style":"normal"},{"_key":"b383023f72d0","_type":"block","children":[{"_key":"280a3bf206360","_type":"span","marks":["strong"],"text":"Procedures for Motions to Withdraw/Substitution Of Counsel: "},{"_key":"6d748a0615530","_type":"span","marks":[],"text":"In accordance with Florida Rule of General Practice and Judicial Administration 2.505, written consent of the client must be filed with the Clerk of Court and opposing counsel (if any) must have no objection to the withdrawal/substitution. If the client has not signed consent and/or opposing counsel has an objection to the withdrawal, a hearing is required."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"de80b63cf493","_type":"block","children":[{"_key":"e606c0a5a5070","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"2528df77f57f","_type":"block","children":[{"_key":"ad22ea983e100","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"57e8827864d7","_type":"block","children":[{"_key":"c4ac16a6df070","_type":"span","marks":["strong"],"text":"Checking the Status of Orders: "},{"_key":"ebd3d77bbb2b0","_type":"span","marks":[],"text":"To inquire about the status of an order, please check the clerk's website first:"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"3c72d34d7566","_type":"block","children":[{"_key":"fe38f6742c000","_type":"span","marks":["2dd1c3accdd5"],"text":"Walton County Clerk of Courts & Comptroller"}],"markDefs":[{"_key":"2dd1c3accdd5","_type":"link","href":"https://waltonclerkfl.gov/"}],"style":"normal"},{"_key":"3279f2ca3d78","_type":"block","children":[{"_key":"7189c99147d60","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"89454dc73e8d","_type":"block","children":[{"_key":"7f02fc1c6e0b0","_type":"span","marks":["strong"],"text":"ALL ORDERS SHALL CONTAIN THE FOLLOWING LANGUAGE ABOVE THE JUDGE’S SIGNATURE BLOCK:"}],"markDefs":[],"style":"normal"},{"_key":"3712075aa9e5","_type":"block","children":[{"_key":"0ddaf9129bee0","_type":"span","marks":[],"text":"DONE AND ORDERED in Chambers, DeFuniak Springs, Walton County, Florida."}],"markDefs":[],"style":"normal"},{"_key":"514bade17b71","_type":"block","children":[{"_key":"fc72523f8c870","_type":"span","marks":["strong"],"text":"CROSS-SETTING OR “PIGGY-BACKING” HEARINGS: "},{"_key":"4fb28ad3dfe60","_type":"span","marks":[],"text":"When a hearing is initially scheduled, the time set aside for the original motion is deemed to be sufficient for that matter only. Adding additional motions is not possible unless there are no objections by opposing counsel/parties to doing so and adequate additional time is available."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"}]}],"slug":{"current":"jonathan-schlechter"},"title":"Jonathan Schlechter"},"type":{"nodes":[{"icon":{"name":"balance"},"recordType":{"slug":{"current":"legal-professionals"}},"_rawChildRecords":null,"slug":{"current":"administrative-orders-directives"},"title":"Administrative Orders & Directives"},{"icon":{"name":"outline_groups_2"},"recordType":{"slug":{"current":"legal-professionals"}},"_rawChildRecords":null,"slug":{"current":"conflict-counsel"},"title":"Conflict Counsel"},{"icon":{"name":"important_devices"},"recordType":{"slug":{"current":"legal-professionals"}},"_rawChildRecords":null,"slug":{"current":"video-hearings-by-zoom"},"title":"Court Hearings by ZOOM "},{"icon":{"name":"interpreter_mode"},"recordType":{"slug":{"current":"legal-professionals"}},"_rawChildRecords":null,"slug":{"current":"court-interpreting"},"title":"Court Interpreting"},{"icon":{"name":"hearing"},"recordType":{"slug":{"current":"legal-professionals"}},"_rawChildRecords":null,"slug":{"current":"court-mediation"},"title":"Court Mediation "},{"icon":{"name":"edit_document"},"recordType":{"slug":{"current":"legal-professionals"}},"_rawChildRecords":null,"slug":{"current":"court-rep