nity.io/images/xf5z3ibd/production/8322b353501be29c790a0f46fc9cc6ca30bb7aa6-200x150.jpg?rect=50,0,100,150&w=%width%&h=%height%&q=80","id":"image-8322b353501be29c790a0f46fc9cc6ca30bb7aa6-200x150-jpg","children":[],"parent":null}},"slug":{"current":"m-c-blanchard-judicial-building"},"title":"M.C. Blanchard Judicial Building"}]},"judge":{"county_upper":"walton county","divisions":"A","fax":"850-892-8377","judge_type":"circuit","metaDescription":null,"metaTitle":null,"phone":"850-892-8131","judicialAssistant":"Candace Bearden, candace.bearden@flcourts1.gov","address":"Walton County Courthouse, 571 U.S. Highway 90 East, Defuniak Springs, FL 32433","onceHubParam":null,"_rawPreferences":[{"_key":"eca0f6fd904b","_type":"richText","blockText":[{"_key":"b8d71eec2983","_type":"block","children":[{"_key":"0c15bd803f290","_type":"span","marks":[],"text":"A. Communications with the Judicial Office"}],"markDefs":[],"style":"normal"},{"_key":"96786cb670b3","_type":"block","children":[{"_key":"52f7342b6bbd0","_type":"span","marks":[],"text":"Method of Communication: All communications to the judicial office must be submitted by e-mail to "},{"_key":"52f7342b6bbd1","_type":"span","marks":["5998bba895af"],"text":"candace.bearden@flcourts1.gov"},{"_key":"52f7342b6bbd2","_type":"span","marks":[],"text":" . The subject line of any e-mail to the judicial office must contain the case number, case name, and relevant matter (e.g., 2024 DR 001234 SC – Doe v. Doe – 2-Hour Hearing Requested)."}],"level":1,"listItem":"bullet","markDefs":[{"_key":"5998bba895af","_type":"link","href":"candace.bearden@flcourts1.gov"}],"style":"normal"},{"_key":"44b1d2e0c587","_type":"block","children":[{"_key":"cd0f04e6228e0","_type":"span","marks":[],"text":"Ex parte Communications: All communications with the judicial office must comply with Canon 3 of the Code of Judicial Conduct, which prohibits a judge from initiating, permitting, or considering ex parte communications and from considering other communications outside the presence of the parties concerning a pending or impending proceeding, unless authorized by law. All parties must be copied on any e-mail directed to the judicial office, unless an ex parte communication is authorized by law."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"e23ef806cf7d","_type":"block","children":[{"_key":"1994900c752b0","_type":"span","marks":[],"text":"Defendants or anyone sending any communication on behalf of a defendant should file the communication with the Clerk of Courtwho will electronically send the communication to Judge Love."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"4818a29e55d4","_type":"block","children":[{"_key":"150955d28dcd0","_type":"span","marks":[],"text":"Unsolicited Communications: Judge Love and his Judicial Assistant are not permitted to give legal advice, which includes suggesting things that might be filed, evaluating the sufficiency of information on a form, interpreting any document, evaluating the conduct of an opposing party or lawyer, or giving an opinion about the likelihood of success of an action in litigation. His Judicial Assistant also cannot recommend specific lawyers or excuse a party/attorney from court appearances (only a judge may grant that request)."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"9ecdf1486a5e","_type":"block","children":[{"_key":"f70f514d3d3e0","_type":"span","marks":[],"text":"E-Filing Portal Contact Information: All attorneys and self-represented litigants must provide an e-mail address to receive signed orders electronically, unless excused. Fla. R. Gen. Prac. & Jud. Admin. 2.516. It is the responsibility of attorneys and self-represented litigants to update their contact information using Form 2.603 any time there is a change in the e-mail account registered for electronic service."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"a81c5fcaa8ed","_type":"block","children":[{"_key":"20a1ac8b6e080","_type":"span","marks":[],"text":"B. Scheduling Procedures"}],"markDefs":[],"style":"normal"},{"_key":"0ba23dce67e4","_type":"block","children":[{"_key":"cbf4b6ba42da0","_type":"span","marks":[],"text":"Scheduling Hearings: When a Motion is filed, it is up to the party who filed the motion to email the Judicial Assistant and ask for the Motion to be set for a hearing.To schedule a Motion for hearing, the Motion must be filed in the court file. Once filed, email the Motion to Judge Love’s Judicial Assistant at "},{"_key":"cbf4b6ba42da1","_type":"span","marks":["20293681cee6"],"text":"candace.bearden@flcourts1.gov"},{"_key":"cbf4b6ba42da2","_type":"span","marks":[],"text":"and include:"}],"level":1,"listItem":"bullet","markDefs":[{"_key":"20293681cee6","_type":"link","href":"candace.bearden@flcourts1.gov"}],"style":"normal"},{"_key":"ea8d34d686f6","_type":"block","children":[{"_key":"5f927ace8cd50","_type":"span","marks":[],"text":"Case number"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"b8edec619f1b","_type":"block","children":[{"_key":"6e304c57ed010","_type":"span","marks":[],"text":"Party Names"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"24ac191280b5","_type":"block","children":[{"_key":"c32639373cdf0","_type":"span","marks":[],"text":"Copy all attorneys involved"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"f78c6a53a19a","_type":"block","children":[{"_key":"3dbb29c296110","_type":"span","marks":[],"text":"Type of hearing"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"d1c6098c4ddb","_type":"block","children":[{"_key":"8ed8270a38270","_type":"span","marks":[],"text":"Length requested for hearing"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"b745f580437e","_type":"block","children":[{"_key":"5015bb911bc50","_type":"span","marks":[],"text":"Any additional information (e.g., hearing needed before/after a certain date, emergency filing, etc.)"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"29a184bccea0","_type":"block","children":[{"_key":"469978159a8f0","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"a30823147321","_type":"block","children":[{"_key":"4f95e69958680","_type":"span","marks":[],"text":"Notice of Hearing: Once the hearing time has been confirmed, a Notice of Hearing must immediately be filed and served. The Notice of Hearing shall advise the Court and all parties of the date, time, and type of hearing. A notice of hearing involving any remote appearance must list the Judge’s Zoom credentials. All notices of hearing must contain the Americans with Disabilities Act (ADA) notification required by Florida Rule of General Practice and Judicial Administration 2.540."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"521c2e47a02d","_type":"block","children":[{"_key":"55375697ae2d0","_type":"span","marks":[],"text":"Order of Proceedings: On criminal hearings dates, Judge Love does not have a preference on who goes first. If an attorney has an appointment with another judge in our courthouse or in another courthouse, please let Judge Love’sJudicial Assistant know in advance so we can accommodate."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"e6feb9f3de38","_type":"block","children":[{"_key":"6d5203fa87390","_type":"span","marks":[],"text":"Continuance Procedure/ Deadlines: "}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"91b4775a801a","_type":"block","children":[{"_key":"ce086aba54af0","_type":"span","marks":[],"text":"All motions to continue must indicate whether opposing counsel objects to the continuance."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"76e1c14bdc7c","_type":"block","children":[{"_key":"e3d447e4d8db0","_type":"span","marks":[],"text":"In criminal matters, all Motions to Continue for Pretrial/Docket Days must be filed by the Friday of the week prior to the Pretrial/Docket Day. If the State or Defense objects to the continuance, the Motion to Continue will be heard on the Pretrial/Docket Day."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"f1f577b83f71","_type":"block","children":[{"_key":"745694215e240","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"e0fbd65891f8","_type":"block","children":[{"_key":"cbc7dba60a060","_type":"span","marks":[],"text":"Cancelling Hearings: If a hearing is no longer necessary, notify Judge Love’sJudicial Assistantvia email at "},{"_key":"cbc7dba60a061","_type":"span","marks":["b366396f921e"],"text":"candace.bearden@flcourts1.gov"},{"_key":"cbc7dba60a062","_type":"span","marks":[],"text":"as soon as possible via email. The only way Judge Love will know of a cancellation is through your notification. If the hearing is cancelled, that time can be made available to others."}],"level":1,"listItem":"bullet","markDefs":[{"_key":"b366396f921e","_type":"link","href":"candace.bearden@flcourts1.gov"}],"style":"normal"},{"_key":"109140ec1f61","_type":"block","children":[{"_key":"78b29372bacb0","_type":"span","marks":[],"text":"Motions for Early Termination of Probation: Defendants may file Motions for Early Termination of Probation in motion or letter form. This should be filed with the Clerk of Court, felony division. The early termination request should include Defendant’s name, case number, Defendant’s address, Defendant's Probation Officer’s name, and the reason for the request for early termination and whether the Probation Officer agrees to the request. Judge Love will either send the defendant an Order granting or denying the motion or he will set the motion for hearing."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"6617550de8f2","_type":"block","children":[{"_key":"64ab10a410f00","_type":"span","marks":[],"text":"C. Remote Appearance Procedure:"}],"markDefs":[],"style":"normal"},{"_key":"9b7472912752","_type":"block","children":[{"_key":"133f6b79d5620","_type":"span","marks":[],"text":"In criminal matters, all requests to use communication technology for an appearance must be made in writing via a motion at least five (5) days in advance of the hearing date. Any objections to the motion must be filed within forty-eight (48) hours of receipt of the motion."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"d7892c0d53a7","_type":"block","children":[{"_key":"0d7e416be70b0","_type":"span","marks":[],"text":"In civil/family law cases, any hearing for one (1) hour or less may appear via Zoom if all parties agree. If all parties do not agree, an in-person hearing will take place unless the Court authorizes appearance by Zoom. Arequest to appear by Zoom must be made in writing via a motion and a proposed order at least five (5) days in advance of the hearing date.Any objections to the motion must be filed within forty-eight (48) hours of receipt of the motion."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"ac169ef1d0d7","_type":"block","children":[{"_key":"e3696a7400650","_type":"span","marks":[],"text":"Platform Used: Zoom (Zoom link will be provided after the hearing date is confirmed.)"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"6e8c0defcca9","_type":"block","children":[{"_key":"e5cab5edea150","_type":"span","marks":[],"text":"Requirements: Participants must be able to use the audio and video functions of zoom. If the hearing is an evidentiary hearing, failure to have a working video may result in the exclusion of testimony."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"1da292a0a45e","_type":"block","children":[{"_key":"0d1c3c5b8da20","_type":"span","marks":[],"text":"D. Submission of Orders and Judgments"}],"markDefs":[],"style":"normal"},{"_key":"4bd06fb6927b","_type":"block","children":[{"_key":"224efed942ad0","_type":"span","marks":[],"text":"Format: All proposed orders must be submitted in Word format and provided to opposing counsel and any self-represented litigant. All proposed orders must be accompanied by a cover letter either (1) certifying that all parties agree to the order or (2) containing a statement identifying any disagreement of the parties as to the proposed order. Proposed Orders must include the names AND e-mail addresses of all parties who need to receive e-service of the Court’s Order. Once signed by the Judge, the Order will be filed with the Clerk with e-service to the e-mail addresses provided."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"34a890d1e08a","_type":"block","children":[{"_key":"eb8625f1e6840","_type":"span","marks":[],"text":"Submission Method: All proposed orders must be submitted to the Court by the proposed order portion of the Florida Courts E-Filing Portal. Please label the proposed Order being submitted with the case name and title of the Order."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"a649372d4f1c","_type":"block","children":[{"_key":"2982d95d96650","_type":"span","marks":[],"text":"Deadline for Submissions: Proposed orders must be submitted within five (5) business days after the court proceeding unless otherwise directed by the Court."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"79244ed14c32","_type":"block","children":[{"_key":"60709410bf6a0","_type":"span","marks":[],"text":"Other Procedures Relating to Submission of Orders and Judgments:"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"8e6847029905","_type":"block","children":[{"_key":"2be1802e40320","_type":"span","marks":[],"text":"Please write “DONE AND ORDERED” with sufficient space below for the Judge’s e-signature.Please do not add a date as it is auto generated."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"42d2c675ec7a","_type":"block","children":[{"_key":"6bb419d7a03c0","_type":"span","marks":[],"text":"If a proposed Order applies to multiple case numbers, separate proposed Orders must be e-filed for each case number."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"974b3a67ce91","_type":"block","children":[{"_key":"540a8b75babe0","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"a34befab9be2","_type":"block","children":[{"_key":"a659f267c8f20","_type":"span","marks":[],"text":"E. Courtesy Copies of Case Law and Other Documents"}],"markDefs":[],"style":"normal"},{"_key":"a2dbeb923865","_type":"block","children":[{"_key":"40da0420ec0e0","_type":"span","marks":[],"text":"When Required: When it is to be relied on in a court proceeding."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"17b8bbfe91de","_type":"block","children":[{"_key":"405f720523880","_type":"span","marks":[],"text":"Format: PDF"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"a001f8f36f03","_type":"block","children":[{"_key":"5fd507d5c32c0","_type":"span","marks":[],"text":"Submission Method: Emailto Judge Love’sJudicial Assistant at "},{"_key":"5fd507d5c32c1","_type":"span","marks":["6b210fd7340e"],"text":"candace.bearden@flcourts1.gov"},{"_key":"5fd507d5c32c2","_type":"span","marks":[],"text":" ."}],"level":1,"listItem":"bullet","markDefs":[{"_key":"6b210fd7340e","_type":"link","href":"candace.bearden@flcourts1.gov"}],"style":"normal"},{"_key":"fb3c8441e7ff","_type":"block","children":[{"_key":"21dc644b2da90","_type":"span","marks":[],"text":"Deadline for Submissions: Within five (5) days of hearing date unless otherwise directed by the Court."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"b0f5cccf1658","_type":"block","children":[{"_key":"af48035ce5850","_type":"span","marks":[],"text":"[Other Courtesy Copies Procedures]: Copy all opposing parties in a case."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"5013ec51747a","_type":"block","children":[{"_key":"6abbca10e1880","_type":"span","marks":[],"text":"F. Emergency and Other Urgent Matters"}],"markDefs":[],"style":"normal"},{"_key":"8332818cf125","_type":"block","children":[{"_key":"89a594c3f3b70","_type":"span","marks":[],"text":"Requirements: E-file the Motion and Email a copy to Judge Love’s Judicial Assistant at "},{"_key":"89a594c3f3b71","_type":"span","marks":["809fefc65c58"],"text":"candace.bearden@flcourts1.gov"},{"_key":"89a594c3f3b72","_type":"span","marks":[],"text":" and mark the email as urgent."}],"level":1,"listItem":"bullet","markDefs":[{"_key":"809fefc65c58","_type":"link","href":"candace.bearden@flcourts1.gov"}],"style":"normal"},{"_key":"9e4a6257fa6e","_type":"block","children":[{"_key":"373908747c5e0","_type":"span","marks":[],"text":"Scheduling: If the Court determines that an emergency exists after reviewing the Motion, an Order will be entered, and a hearing will be scheduled unilaterally by the Court. The parties must make themselves available for the scheduled hearing."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"c9b06282179b","_type":"block","children":[{"_key":"e514aa88d39b0","_type":"span","marks":[],"text":"G. Exhibits for Evidentiary Proceedings"}],"markDefs":[],"style":"normal"},{"_key":"24fe5b3bdd9f","_type":"block","children":[{"_key":"0a2f6c21647e0","_type":"span","marks":[],"text":"Submission Method: Exhibits for criminal evidentiary proceedings must be presented during the hearing. However, if both the State and Defense stipulate to the Court considering certain evidence prior to the hearing (such as a forensic interview for a Child Hearsay hearing), the physical exhibit may be sent to Judge Love’s Judicial Assistant for Judge Love to review in chambers."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"a84717f65f17","_type":"block","children":[{"_key":"3da05d03fa250","_type":"span","marks":[],"text":"Format: Exhibits must be labeled prior to offering them as an exhibit."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"608cc487574a","_type":"block","children":[{"_key":"9ec014adf7d50","_type":"span","marks":[],"text":"Deadline for Submissions: Three (3) business days prior to the hearing."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"5ae9a14f9a8f","_type":"block","children":[{"_key":"c0fa88c5ba010","_type":"span","marks":[],"text":"H. Pretrial Procedures and Conferences"}],"markDefs":[],"style":"normal"},{"_key":"b4b758f52339","_type":"block","children":[{"_key":"0fafeb2559e10","_type":"span","marks":[],"text":"Case Management Conferences (CIVIL/FAMILY LAW CASES): Any party may request a Case Management Conference, and a Case Management Conference may be scheduled by the Court unilaterally."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"087b7e310b5b","_type":"block","children":[{"_key":"2203b27eb5a10","_type":"span","marks":[],"text":"I. Setting Case for Trial"}],"markDefs":[],"style":"normal"},{"_key":"eb6b9b9bb006","_type":"block","children":[{"_key":"e2b08a79c76d0","_type":"span","marks":[],"text":"Procedure:For criminal cases that are announced as ready for trial at the Pretrial hearing, those cases will be scheduled for a Docket Day hearing. If the case is not resolved at the Docket Day hearing, it will proceed to jury selection the following Monday unless otherwise directed by the Court."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"0fdd3a1658f9","_type":"block","children":[{"_key":"d9fea8033c8e0","_type":"span","marks":[],"text":"J. Forms"}],"markDefs":[],"style":"normal"},{"_key":"362561d33fb8","_type":"block","children":[{"_key":"02214d770fd50","_type":"span","marks":[],"text":"Access: N/A"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"366600b7972e","_type":"block","children":[{"_key":"30453088b04a0","_type":"span","marks":[],"text":"Usage: N/A"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"18caa1d1973e","_type":"block","children":[{"_key":"4a55539b8d170","_type":"span","marks":[],"text":"[Other Forms Procedures]: N/A"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"8f59a4c7c0fd","_type":"block","children":[{"_key":"e5408dc65e9c0","_type":"span","marks":[],"text":"K. Other Division Procedures"}],"markDefs":[],"style":"normal"},{"_key":"973a4c381301","_type":"block","children":[{"_key":"45c58d31e6300","_type":"span","marks":[],"text":"ADA Accommodations: Administrative Order 2015-32 requires that all notices of court proceedings include the following ADA notice (in Times New Roman or Courier, 14-point bold font):"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"ebe77d726f81","_type":"block","children":[{"_key":"86fce79ab25a0","_type":"span","marks":[],"text":"If you are a person with a disability who needs any accommodation in order to participate in this proceeding, you are entitled, at no cost to you, to the provision of certain assistance. Please contact: Court Administration, ADA Liaison, Escambia County, 190 Governmental Center, 5th Floor, Pensacola, FL 32502, Phone (850) 595-4400, Fax (850) 595-0360,"},{"_key":"86fce79ab25a1","_type":"span","marks":["fb74fc700b25"],"text":"ADA.Walton@flcourts1.gov"},{"_key":"86fce79ab25a2","_type":"span","marks":[],"text":"."}],"markDefs":[{"_key":"fb74fc700b25","_type":"link","href":"ADA.Walton@flcourts1.gov"}],"style":"normal"},{"_key":"e52173aa699c","_type":"block","children":[{"_key":"66dfa9b83c680","_type":"span","marks":[],"text":"Interpreter Requests: If an interpreter is needed for a hearing or trial, please contact Court Administration to request an interpreter at (850) 595-4533 or "},{"_key":"66dfa9b83c681","_type":"span","marks":["4a821f5090cf"],"text":"Trinidad.SerranoBennitt@flcourts1.gov"},{"_key":"66dfa9b83c682","_type":"span","marks":[],"text":"."}],"level":1,"listItem":"bullet","markDefs":[{"_key":"4a821f5090cf","_type":"link","href":"Trinidad.SerranoBennitt@flcourts1.gov"}],"style":"normal"},{"_key":"6bb39b469231","_type":"block","children":[{"_key":"dbe61a6eedb60","_type":"span","marks":[],"text":"Decorum: All counsel and other persons attending hearings and trials should conduct themselves in the following customary and traditional manner:"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"ba4834f87b93","_type":"block","children":[{"_key":"bc67e5eec4450","_type":"span","marks":[],"text":"Stand as court is opened, recessed, or adjourned for all matters held in the courtroom."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"83db43a867b9","_type":"block","children":[{"_key":"7eb4f380f3a00","_type":"span","marks":[],"text":"Stand when the jury enters or retires from the courtroom."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"c0e4ba09515c","_type":"block","children":[{"_key":"c752625477990","_type":"span","marks":[],"text":"Stand when addressing or being addressed by the Court for all matters held in the courtroom."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"64f88f6d8fb6","_type":"block","children":[{"_key":"9423e464ffb20","_type":"span","marks":[],"text":"Address all remarks to the Court, not to opposing counsel."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"dd6fb45ba6f7","_type":"block","children":[{"_key":"5ac0e6d131a10","_type":"span","marks":[],"text":"Avoid disparaging personal remarks or acrimony toward opposing counsel and remain wholly detached from any ill feeling between the litigants or witnesses."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"7e329a26f93d","_type":"block","children":[{"_key":"1111528344320","_type":"span","marks":[],"text":"Refer to all persons, including witnesses, other counsel, and the parties, by their surnames and not by their first or given names."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"b09eae550cd3","_type":"block","children":[{"_key":"eb142a64d3310","_type":"span","marks":[],"text":"In making objections, counsel should state only the legal grounds for the objection and should withhold all further comment or argument unless elaboration is requested by the Court."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"46ce3cbaba6c","_type":"block","children":[{"_key":"c260f55a4d990","_type":"span","marks":[],"text":"Counsel shall admonish and discourage all persons (parties, witnesses, and observers) from making gestures, facial expressions, audible comments, or the like, as manifestations of approval or disapproval during the testimony of witnesses, or at any other time."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"}]}],"slug":{"current":"j-ryan-love"},"title":"J. Ryan Love, Administrative Judge"},"type":{"nodes":[{"icon":{"name":"balance"},"recordType":{"slug":{"current":"legal-professionals"}},"_rawChildRecords":null,"slug":{"current":"administrative-orders-directives"},"title":"Administrative Orders & Directives"},{"icon":{"name":"outline_groups_2"},"recordType":{"slug":{"current":"legal-professionals"}},"_rawChildRecords":null,"slug":{"current":"conflict-counsel"},"title":"Conflict Counsel"},{"icon":{"name":"important_devices"},"recordType":{"slug":{"current":"legal-professionals"}},"_rawChildRecords":null,"slug":{"current":"video-hearings-by-zoom"},"title":"Court Hearings by ZOOM "},{"icon":{"name":"interpreter_mode"},"recordType":{"slug":{"current":"legal-professionals"}},"_rawChildRecords":null,"slug":{"current":"court-interpreting"},"title":"Court Interpreting"},{"icon":{"name":"hearing"},"recordType":{"slug":{"current":"legal-professionals"}},"_rawChildRecords":null,"slug":{"current":"court-mediation"},"title":"Court Mediation "},{"icon":{"name":"edit_document"},"recordType":{"slug":{"current":"legal-professionals"}},"_rawChildRecords":null,"slug":{"current":"court-reporting"},"title":"Court Reporting"},{"icon":{"name":"outline_monitor"},"recordType":{"slug":{"current":"legal-professionals"}},"_rawChildRecords":null,"slug":{"current":"court-technology-legal"},"title":"Courtroom Technology"},{"icon":{"name":"outline_man"},"recordType":{"slug":{"current":"legal-professionals"}},"_rawChildRecords":null,"slug":{"current":"expert-witness-registry"},"title":"Expert Witness Registry "},{"icon":{"name":"outline_gavel"},"recordType":{"slug":{"current":"legal-professionals"}},"_rawChildRecords":null,"slug":{"current":"judges"},"title":"Judges"},{"icon":{"name":"menu_book"},"recordType":{"slug":{"current":"legal-professionals"}},"_rawChildRecords":null,"slug":{"current":"law-library"},"title":"Law Library "},{"icon":{"name":"outline_reduce_capacity"},"recordType":{"slug":{"current":"legal-professionals"}},"_rawChildRecords":null,"slug":{"current":"magistrates-hearing-officers"},"title":"Magistrates/Hearing Officers"},{"icon":{"name":"article"},"recordType":{"slug":{"current":"legal-professionals"}},"_rawChildRecords":null,"slug":{"current":"process-servers"},"title":"Process Servers "}]}},"pageContext":{"slug":"j-ryan-love"}},"staticQueryHashes":["3179213691","3649515864","3764592887","389233011"],"slicesMap":{}}