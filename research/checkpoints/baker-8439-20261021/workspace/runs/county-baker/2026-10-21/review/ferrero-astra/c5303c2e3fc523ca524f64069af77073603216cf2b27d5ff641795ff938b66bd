/* --------------------------------------------------------------
   FIX: Remove Salient's extra megamenu vertical offset
   Salient pushed our megamenus above the bottom edge of the global header block using:
       .sf-menu > li.megamenu > ul.sub-menu { top: calc(100% + 15px); }
   This override aligns megamenu dropdowns flush with the header’s
   bottom border so they match standard (non-mega) dropdown behavior.
-------------------------------------------------------------- */
#header-outer header#top .sf-menu > li.megamenu > ul.sub-menu {
    top: calc(100% - 1px) !important; /* adjusts for the gold border */
}

/* --------------------------------------------------------------
   STANDARD DROPDOWNS — fade IN only, instant hide on un-hover
-------------------------------------------------------------- */

/* Closed (hidden) state */
#header-outer header#top .sf-menu > li:not(.megamenu) > ul.sub-menu {
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: none !important; /* no fade OUT */
}

/* Open (visible) state — hover + Superfish */
#header-outer header#top .sf-menu > li:not(.megamenu):hover > ul.sub-menu,
#header-outer header#top .sf-menu > li:not(.megamenu).sfHover > ul.sub-menu,

/* Open (visible) state — click-open (ARIA) */
#header-outer header#top
.sf-menu > li:not(.megamenu) > a[aria-expanded="true"] + ul.sub-menu,

/* Open (visible) state — keyboard */
#header-outer header#top
.sf-menu > li:not(.megamenu):focus-within > ul.sub-menu {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    transition: opacity 0.35s ease, transform 0.35s ease !important;
}



/* --------------------------------------------------------------
   ACTIVE PAGE / SELECTED MENU ITEM (Standard dropdowns)
-------------------------------------------------------------- */

/* Top-level and ancestors */
#header-outer .sf-menu li.current-menu-item > a,
#header-outer .sf-menu li.current_page_item > a,
#header-outer .sf-menu li.current-menu-ancestor > a,
#header-outer .sf-menu li.current_page_ancestor > a {
    color: #0F203A !important;  /* gold */
}

/* Inside dropdown sub-menu */
#header-outer .sf-menu li ul.sub-menu li.current-menu-item > a,
#header-outer .sf-menu li ul.sub-menu li.current_page_item > a {
    color: #0F203A !important;
}



/* --------------------------------------------------------------
   DROPDOWN TEXT COLORS — STAY VISIBLE UNTIL UN-HOVER
-------------------------------------------------------------- */

/* Default text = white (when menu is open) */
#header-outer header#top
.sf-menu > li:not(.megamenu):hover ul.sub-menu li > a .menu-title-text,

#header-outer header#top
.sf-menu > li:not(.megamenu) > a[aria-expanded="true"] + ul.sub-menu li > a .menu-title-text,

#header-outer header#top
.sf-menu > li:not(.megamenu):focus-within ul.sub-menu li > a .menu-title-text {
    opacity: 1;
    visibility: visible;
}

/* Selected item inside dropdown = gold */
#header-outer header#top nav > ul > li:not(.megamenu) ul.sub-menu li.current-menu-item > a .menu-title-text,
#header-outer header#top nav > ul > li:not(.megamenu) ul.sub-menu li.current_page_item > a .menu-title-text,
#header-outer header#top nav > ul > li:not(.megamenu) ul.sub-menu li.current-menu-ancestor > a .menu-title-text,
#header-outer header#top nav > ul > li:not(.megamenu) ul.sub-menu li.current_page_ancestor > a .menu-title-text {
    color: #EBC55B !important;
}

/* Hover = gold text (dropdown items only) */
#header-outer header#top
.sf-menu > li:not(.megamenu) ul.sub-menu li > a:hover .menu-title-text {
    color: #EBC55B !important;
}

/* =========================================================
   STANDARD DROPDOWN CONTENT — FORCE VISIBILITY (Salient)
   Fixes “empty dropdown panel” where background shows but items don’t
========================================================= */

/* Define the OPEN states once */
#header-outer header#top .sf-menu > li:not(.megamenu):hover > ul.sub-menu,
#header-outer header#top .sf-menu > li:not(.megamenu).sfHover > ul.sub-menu,
#header-outer header#top .sf-menu > li:not(.megamenu) > a[aria-expanded="true"] + ul.sub-menu,
#header-outer header#top .sf-menu > li:not(.megamenu):focus-within > ul.sub-menu {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
    transform: translateY(0) !important;
    z-index: 9999 !important; /* ensure above header/hero layers */
}

/* Force descendants to be visible */
#header-outer header#top .sf-menu > li:not(.megamenu):hover > ul.sub-menu li,
#header-outer header#top .sf-menu > li:not(.megamenu).sfHover > ul.sub-menu li,
#header-outer header#top .sf-menu > li:not(.megamenu) > a[aria-expanded="true"] + ul.sub-menu li,
#header-outer header#top .sf-menu > li:not(.megamenu):focus-within > ul.sub-menu li,
#header-outer header#top .sf-menu > li:not(.megamenu):hover > ul.sub-menu a,
#header-outer header#top .sf-menu > li:not(.megamenu).sfHover > ul.sub-menu a,
#header-outer header#top .sf-menu > li:not(.megamenu) > a[aria-expanded="true"] + ul.sub-menu a,
#header-outer header#top .sf-menu > li:not(.megamenu):focus-within > ul.sub-menu a,
#header-outer header#top .sf-menu > li:not(.megamenu):hover > ul.sub-menu a .menu-title-text,
#header-outer header#top .sf-menu > li:not(.megamenu).sfHover > ul.sub-menu a .menu-title-text,
#header-outer header#top .sf-menu > li:not(.megamenu) > a[aria-expanded="true"] + ul.sub-menu a .menu-title-text,
#header-outer header#top .sf-menu > li:not(.megamenu):focus-within > ul.sub-menu a .menu-title-text {
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
}

/* Make sure text color is not being overridden to transparent/same-as-bg */
#header-outer header#top .sf-menu > li:not(.megamenu) ul.sub-menu a,
#header-outer header#top .sf-menu > li:not(.megamenu) ul.sub-menu a .menu-title-text {
    color: #ffffff !important;
}

/* Keep your hover gold behavior */
#header-outer header#top .sf-menu > li:not(.megamenu) ul.sub-menu a:hover .menu-title-text {
    color: #EBC55B !important;
}

#header-outer header#top .sf-menu > li:not(.megamenu) ul.sub-menu a:focus-visible .menu-title-text {
    color: #EBC55B !important;
    text-decoration: underline !important;
}
/* =========================================================
   Standard Menu ACTIVE DROPDOWN ITEM (selected page)
========================================================= */

/* Selected page when NOT hovered (orange background) */
#header-outer header#top
.sf-menu > li:not(.megamenu) ul.sub-menu li.current-menu-item > a .menu-title-text,
#header-outer header#top
.sf-menu > li:not(.megamenu) ul.sub-menu li.current_page_item > a .menu-title-text,
#header-outer header#top
.sf-menu > li:not(.megamenu) ul.sub-menu li.current-menu-ancestor > a .menu-title-text,
#header-outer header#top
.sf-menu > li:not(.megamenu) ul.sub-menu li.current_page_ancestor > a .menu-title-text {
    color: #0F203A !important; /* navy text on orange */
}


/* Selected page WHEN hovered (navy background) */
#header-outer header#top
.sf-menu > li:not(.megamenu) ul.sub-menu li.current-menu-item > a:hover .menu-title-text,
#header-outer header#top
.sf-menu > li:not(.megamenu) ul.sub-menu li.current_page_item > a:hover .menu-title-text,
#header-outer header#top
.sf-menu > li:not(.megamenu) ul.sub-menu li.current-menu-ancestor > a:hover .menu-title-text,
#header-outer header#top
.sf-menu > li:not(.megamenu) ul.sub-menu li.current_page_ancestor > a:hover .menu-title-text {
    color: #EBC55B !important; /* gold text on navy */
}

/* =========================================================
   MEGAMENU — selected page text color
========================================================= */

/* Selected item on orange background */
#header-outer header#top
.sf-menu > li.megamenu ul.sub-menu li.current-menu-item > a .menu-title-text,
#header-outer header#top
.sf-menu > li.megamenu ul.sub-menu li.current_page_item > a .menu-title-text,
#header-outer header#top
.sf-menu > li.megamenu ul.sub-menu li.current-menu-ancestor > a .menu-title-text,
#header-outer header#top
.sf-menu > li.megamenu ul.sub-menu li.current_page_ancestor > a .menu-title-text {
    color: #0F203A !important;
}

/* Selected item when hovered back onto navy */
#header-outer header#top
.sf-menu > li.megamenu ul.sub-menu li.current-menu-item > a:hover .menu-title-text,
#header-outer header#top
.sf-menu > li.megamenu ul.sub-menu li.current_page_item > a:hover .menu-title-text,
#header-outer header#top
.sf-menu > li.megamenu ul.sub-menu li.current-menu-ancestor > a:hover .menu-title-text,
#header-outer header#top
.sf-menu > li.megamenu ul.sub-menu li.current_page_ancestor > a:hover .menu-title-text {
