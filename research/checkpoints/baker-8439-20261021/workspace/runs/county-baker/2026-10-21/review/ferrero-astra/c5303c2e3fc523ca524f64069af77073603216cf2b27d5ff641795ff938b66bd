}

/* ============================================================
   CALENDAR TILES — FINAL STABLE BLOCK
   (layout, sizing, colors, hover, equal height)
============================================================ */


/* ============================================================
   1. GRID LAYOUT (DESKTOP / BASE)
============================================================ */

.calendarLists {
    display: block !important;
}

.calendarLists .row_col_wrap_12 {
    display: flex !important;
    flex-wrap: wrap !important;
    justify-content: center !important;
    align-items: stretch !important;

    column-gap: 10px !important;
    row-gap: 10px !important;
}

/* 3 tiles per row on desktop */
.calendarLists .row_col_wrap_12 .wpb_column {
    flex: 0 0 30% !important;
    max-width: 30% !important;

    display: flex !important;
    flex-direction: column !important;
}


/* ============================================================
   2. EQUAL-HEIGHT PLUMBING
============================================================ */

.calendarLists .vc_column-inner,
.calendarLists .wpb_wrapper,
.calendarLists .wpb_text_column,
.calendarLists .wpb_text_column > p {
    flex: 1 1 auto !important;
    display: flex !important;
    flex-direction: column !important;

    margin: 0 !important;
}


/* ============================================================
   3. TILE APPEARANCE (DEFAULT STATE)
============================================================ */
/*
This is the clickable tile itself (<a>).
It fills available height and width and centers text.
*/
.calendarLists .wpb_text_column > p > a {
    flex: 1 1 auto !important;
    width: 100% !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    background-color: #1C3357 !important; /* default tile color */
    color: #ffffff !important;

    border-radius: 6px;
    padding: 26px 12px !important;

    text-align: center;
    text-decoration: none !important;

    transition:
        background-color 0.25s ease,
        color 0.25s ease;

    box-shadow: none !important;
    border: none !important;
}


/* ============================================================
   4. TEXT COLOR SAFETY (NON-HOVER)
============================================================ */
/*
Prevents Salient from dimming text or applying opacity rules.
Ensures white text ALWAYS shows.
*/

.calendarLists .wpb_text_column > p,
.calendarLists .wpb_text_column > p > a {
    color: #ffffff !important;
    opacity: 1 !important;
}


/* ============================================================
   5. HOVER + FOCUS STATES
============================================================ */
/*
Hover behavior:
- Darker background
- Gold text
- Keyboard accessibility via :focus-visible
*/
.calendarLists .wpb_text_column > p > a:hover,
.calendarLists .wpb_text_column > p > a:focus-visible {
    background-color: #0F203A !important; /* darker hover color */
    color: #EBC55B !important;            /* gold text */
    outline: none;
}

.calendarLists a:focus-visible {
  outline: 2px solid #0F203A !important;
  outline-offset: 4px !important;
}

/* ============================================================
   6. TABLET DEVICES (iPad, Surface, Foldables)
============================================================ */

@media (min-width: 700px) and (max-width: 1099px) {

    .calendarLists .row_col_wrap_12 {
        column-gap: 0 !important;
    }

    .calendarLists .row_col_wrap_12 .wpb_column {
        flex: 0 0 100% !important;
        max-width: 100% !important;
    }
    
     /* Kill WPBakery/SALIENT column spacing that looks like "mystery row gaps" */
  .calendarLists .wpb_column,
  .calendarLists .vc_column_container {
      margin-bottom: 0 !important;
      padding-bottom: 0 !important;
  }

  .calendarLists .vc_column-inner {
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      min-height: 0 !important;
  }

  /* Ensure the ONLY vertical spacing is your row-gap */
  .calendarLists .row_col_wrap_12 {
      row-gap: 22px !important; /* keep your intended spacing */
  }
}


/* ============================================================
   7. MOBILE
============================================================ */

@media (max-width: 690px) {

    .calendarLists .row_col_wrap_12 {
        column-gap: 0 !important;
    }

    .calendarLists .row_col_wrap_12 .wpb_column {
        flex: 0 0 100% !important;
        max-width: 100% !important;
    }
}


/* ============================================================
   8. SALIENT / WPBAKERY ROW-BG FIX
============================================================ */
/*
This block fixes the "phantom vertical spacing" bug.
Salient inserts row-bg-wrap elements that reserve height.
These MUST be collapsed.
*/

/* Completely collapse the background wrapper */
.calendarLists > .row-bg-wrap {
    position: absolute !important;
    height: 0 !important;
    min-height: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    overflow: hidden !important;
}

/* Ensure inner background layers do not reintroduce height */
.calendarLists > .row-bg-wrap,
.calendarLists > .row-bg-wrap > .inner-wrap,
.calendarLists > .row-bg-wrap .row-bg {
    height: 0 !important;
    min-height: 0 !important;
}

/* Ensure the visible content controls the row height */
.calendarLists {
    position: relative !important;
}

/* Remove spacing after calendar rows */
.vc_row.calendarLists {
    margin-bottom: 0 !important;
    padding-bottom: 10 !important;
}

/* Remove spacing before the next row */
.vc_row.calendarLists + .vc_row {
    margin-top: 0 !important;
    padding-top: 0 !important;
}


/* ============================================================
   9. HEADERS (NON-TILE ROWS)
============================================================ */
/*
Used ONLY for section headers like:
"By Division – [year]"
Prevents them from inheriting tile spacing logic.
*/
.calendarHeader {
    margin-top: 0px !important;
    padding-top: 20px !important;
    padding-bottom: 20px !important;
    margin-bottom: 0px !important;
}

.calendarHeader,
.calendarHeader * {
    text-align: center !important;
}

